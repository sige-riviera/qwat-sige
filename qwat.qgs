      <renderer-v2 forceraster="0" type="RuleRenderer" enableorderby="0" referencescale="-1" symbollevels="0">
        <rules key="{89d1d7f3-6dd2-48ab-a978-572c899af422}">
          <rule label="fonctionnel" filter="fk_distributor = 1 AND status_functional IS TRUE" key="{71a064ea-fc5d-4548-9c69-5bf1fe84a66d}">
            <rule label="actif" filter="status_active IS TRUE AND (fk_parent IS NULL OR @map_scale &lt; 501)" key="{e946cc4f-cd0b-4ad9-8be4-7ffafae00622}">
              <rule label="Chambre" filter="installation_type = 'chamber'" key="{5a17ff38-f410-4abf-be4e-9c79367de4fe}">
                <rule label="Chambre débitmètre" symbol="0" filter="flow_meter IS TRUE or water_meter IS TRUE or manometer IS TRUE" key="{8822d14f-21ea-400b-ad73-aafc21c19773}"/>
                <rule label="Chambre" symbol="1" filter="ELSE" key="{6ade4f06-ed80-4a3f-9fe9-38516a340cad}"/>
              </rule>
              <rule label="pressurecontrol" filter="installation_type = 'pressurecontrol'" key="{7773e49d-eae4-41b4-8d92-aec7a265046c}">
                <rule label="Chambre réducteur" symbol="2" filter=" &quot;fk_pressurecontrol_type&quot; =  2801 " key="{f315adf4-c25e-4483-bab6-237fe3a60041}"/>
                <rule label="Chambre coupe pression" symbol="3" filter=" &quot;fk_pressurecontrol_type&quot; =  2802" key="{bcc4a12d-4133-4556-adb8-a3cdedbd5406}"/>
                <rule label="Chambre de rassemblement" symbol="4" filter=" &quot;fk_pressurecontrol_type&quot; =  2803" key="{f018225f-1a3d-44eb-b8a3-fcea387c5b34}"/>
              </rule>
              <rule label="pump" symbol="5" filter="installation_type = 'pump'" key="{bcb1f704-8435-4019-bd6f-781938ef8ad9}"/>
              <rule label="source" symbol="6" filter="installation_type = 'source'" key="{2751ab65-3b68-4243-afab-9ebdcb9f8241}"/>
              <rule label="tank" symbol="7" filter="installation_type = 'tank'" key="{8af2dff4-7bea-42be-9478-3f1d88ebf33d}"/>
              <rule label="treatment" symbol="8" filter="installation_type = 'treatment'" key="{42540c94-3233-498c-a23d-4e8bd7c1ff4e}"/>
              <rule symbol="9" filter="ELSE" key="{ed82ce06-eee6-4f2d-833b-e537d0b18649}"/>
            </rule>
