                  <rule filter=" COALESCE(&quot;schema_force_visible&quot;,&quot;valve_function_schema_visible&quot;) IS TRUE &#xa;AND COALESCE( &quot;pipe_schema_force_visible&quot; , &quot;pipe_pipe_function_schema_visible&quot; ) IS TRUE" key="{7a025dab-c7fe-4c7c-9f0b-25a39f73abd8}" scalemaxdenom="100000" label="réseau" description="toutes les vannes sauf organe réseau et vanne d'hydrant" scalemindenom="1">
