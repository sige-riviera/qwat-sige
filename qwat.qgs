                              <Option type="bool" name="active" value="true"/>
                              <Option type="QString" name="expression" value="concat('C:\\qgis\\qwat-sige\\symbols\\parts\\', CASE &#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20001 THEN 'Bride.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20002 THEN 'Collet réduit.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20004 THEN 'Manchon - E.S.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20005 THEN 'Manchon - Hawley.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20006 THEN 'Manchon - Hymax a bride.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20007 THEN 'Manchon - Hymax Grip.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20009 THEN 'Manchon - Raccord bride a Vis.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20008 THEN 'Manchon - Raccord de Vanne.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20010 THEN 'Manchon - Raccord Hawley a bride.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20011 THEN 'Manchon - Raccord Vis a Vis.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20012 THEN 'PE Coude 30°.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20013 THEN 'PE Coude 45°.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20014 THEN 'PE Coude 90°.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20015 THEN 'Tete Fonte.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20018 THEN 'Soudure.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20020 THEN 'PE Coude 15°.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20021 THEN 'Fonte Coude M-F 45° droite.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20022 THEN 'Fonte Coude M-F 45° gauche.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20023 THEN 'Fonte Coude M-F 15° droite.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20024 THEN 'Fonte Coude M-F 15° gauche.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20025 THEN 'All. Fonte à bride.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20026 THEN 'Fonte Coude F-F 45° droite.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20027 THEN 'Fonte Coude F-F 45° gauche.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20028 THEN 'Fonte Coude F-F 15° droite.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20029 THEN 'Fonte Coude F-F 15° droite.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20030 THEN 'Soudure.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20031 THEN 'Fonte Té.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20032 THEN 'PE Té.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20033 THEN 'Fonte réduction.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20034 THEN 'PE réduction.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20035 THEN 'Fonte coude M-F vertical.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20036 THEN 'Fonte coude F-F vertical.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20037 THEN 'dot.svg'&#xd;&#xa;WHEN &quot;fk_part_type&quot; = 20038 THEN 'Vanne a bride.svg'&#xd;&#xa;ELSE 'dot.svg'&#xd;&#xa;END)"/>
