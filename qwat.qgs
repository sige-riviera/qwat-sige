                <rules key="{8ac6d04b-1bb5-46e9-b2fb-236cb107ffc9}">
                  <rule scalemindenom="1" label="réseau" scalemaxdenom="100000" filter=" COALESCE(&quot;schema_force_visible&quot;,&quot;valve_function_schema_visible&quot;) IS TRUE &#xa;AND COALESCE( &quot;pipe_schema_force_visible&quot; , &quot;pipe_pipe_function_schema_visible&quot; ) IS TRUE" description="toutes les vannes sauf organe réseau et vanne d'hydrant" key="{7a025dab-c7fe-4c7c-9f0b-25a39f73abd8}">
                    <rule label="Fermée" symbol="0" filter="closed IS TRUE" key="{edf1c363-d849-4700-82d0-34d494178d4d}"/>
                    <rule label="arrêt" symbol="1" filter="&quot;fk_valve_type&quot; =6313" key="{6c48a279-b0d9-428b-819c-2fc5371720fe}"/>
                    <rule label="vidange" symbol="2" filter="fk_valve_function IN (6110,6112)" key="{8f1997aa-ce0e-467b-a33f-719c22255041}"/>
