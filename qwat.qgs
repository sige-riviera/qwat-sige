                  <rule key="{e5a2b637-7c59-4da4-96f8-9cafa9cb41c6}" symbol="1" label="2 = Conduite supprimée" filter="&quot;type&quot; = 2 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{57471ccc-969b-4a2f-aaf3-ea8c8e31e5fe}" symbol="2" label="3 = Conduite branchement projetée" filter="&quot;type&quot; = 3 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{51f9710c-2f47-4494-8534-c728849caf89}" symbol="3" label="4 = By-pass" filter="&quot;type&quot; = 4  AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{3a6d4d13-5b86-4fea-ba6d-29de9760f60a}" symbol="4" label="5 = Spécial" filter="&quot;type&quot; = 5 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{d4af20fc-5849-4ce7-8262-f6df8dc1be65}" symbol="5" label="6 = Télécommande ou SOMO projeté" checkstate="0" filter="&quot;type&quot; = 6 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{8920e615-3516-4b03-9cab-40b78f9107e0}" symbol="6" label="7 = Projets de tiers" filter="&quot;type&quot; = 7 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)"/>
                  <rule key="{dcc89366-d86b-4215-b87d-dbe86e2bee65}" symbol="7" label="Type inconnu, invisible, autre nom de plan" checkstate="0" filter="ELSE"/>
