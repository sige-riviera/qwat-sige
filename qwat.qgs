                  <rule filter="&quot;type&quot; = 1 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="0" key="{67e01c4f-1599-4f7e-bb85-eb99534fad7b}" label="1 = Conduite réseau projetée"/>
                  <rule filter="&quot;type&quot; = 2 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="1" key="{e5a2b637-7c59-4da4-96f8-9cafa9cb41c6}" label="2 = Conduite supprimée"/>
                  <rule filter="&quot;type&quot; = 3 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="2" key="{57471ccc-969b-4a2f-aaf3-ea8c8e31e5fe}" label="3 = Conduite branchement projetée"/>
                  <rule filter="&quot;type&quot; = 4  AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="3" key="{51f9710c-2f47-4494-8534-c728849caf89}" label="4 = By-pass"/>
                  <rule filter="&quot;type&quot; = 5 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="4" key="{3a6d4d13-5b86-4fea-ba6d-29de9760f60a}" label="5 = Spécial"/>
                  <rule filter="&quot;type&quot; = 6 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="5" key="{d4af20fc-5849-4ce7-8262-f6df8dc1be65}" checkstate="0" label="6 = Télécommande ou SOMO projeté"/>
                  <rule filter="&quot;type&quot; = 7 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" symbol="6" key="{8920e615-3516-4b03-9cab-40b78f9107e0}" label="7 = Projets de tiers"/>
                  <rule filter="ELSE" symbol="7" key="{dcc89366-d86b-4215-b87d-dbe86e2bee65}" checkstate="0" label="Type inconnu, invisible, autre nom de plan"/>
