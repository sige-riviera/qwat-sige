          <rule symbol="2" filter=" &quot;fk_function&quot; = 4102" key="{d30f21d4-4b49-4c45-8f3f-3d8b9c7cec32}" scalemindenom="1" label="conduites d'hydrantes pour plans BH" scalemaxdenom="2600"/>
