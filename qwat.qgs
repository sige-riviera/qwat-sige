          <rule symbol="4" filter=" &quot;fk_protection&quot; IS NOT NULL" key="{a95a4acd-9cc7-42c0-8dc2-fa8bdc1dcb90}" scalemindenom="1" label="protégée" scalemaxdenom="6000"/>
