          <rule key="{e514b9fe-f3f7-4d71-b649-b0e192f0df27}" symbol="0" filter="&quot;fk_pipe&quot; IS NOT NULL AND &quot;pipe_status_functional&quot; IS TRUE" label="Fuite sur conduite fonctionnelle"/>
          <rule key="{b32c8aa4-35a9-496c-a51f-08831f6ad259}" symbol="1" filter="&quot;fk_pipe&quot; IS NOT NULL AND &quot;pipe_status_functional&quot; IS FALSE" label="Fuite sur conduite non-fonctionnelle"/>
          <rule key="{f989ad58-3557-4fe1-88d3-b0567e29041f}" symbol="2" filter="&quot;fk_pipe&quot; IS NULL" label="Fuite non rattachée à une conduite"/>
          <rule key="{1aaa2d43-a730-40bd-8ea5-c10492767b54}" symbol="3" filter="&quot;fk_pipe&quot; IS NOT NULL AND &quot;pipe_status_functional&quot; IS TRUE AND year(&quot;repair_date&quot;) &lt; &quot;pipe_year&quot; AND &quot;pipe__length2d&quot; > 3" label="Fuite attachée à conduite (>3m) plus récente"/>
          <rule key="{1f67b439-207c-486c-b1f2-16326db05ec5}" symbol="4" filter="&quot;fk_pipe&quot; IS NOT NULL AND &quot;pipe_status_functional&quot; IS TRUE AND year(&quot;repair_date&quot;) = &quot;pipe_year&quot; AND &quot;pipe__length2d&quot; > 3" label="Fuite attachée à conduite (>3m) de même année"/>
          <rule key="{3e62e68c-f72d-4462-a7bb-4a755a5ffda7}" symbol="5" filter="ELSE" label="Autres"/>
        </rules>
