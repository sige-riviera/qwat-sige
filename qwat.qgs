                  <rule key="{d4af20fc-5849-4ce7-8262-f6df8dc1be65}" checkstate="0" symbol="5" filter="&quot;type&quot; = 6 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" label="6 = Télécommande ou SOMO projeté"/>
                  <rule key="{8920e615-3516-4b03-9cab-40b78f9107e0}" symbol="6" filter="&quot;type&quot; = 7 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" label="7 = Projets de tiers"/>
