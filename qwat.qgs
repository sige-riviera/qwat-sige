                  <rule key="{e5a2b637-7c59-4da4-96f8-9cafa9cb41c6}" symbol="1" filter="&quot;type&quot; = 2 AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" label="2 = Conduite supprimée"/>
