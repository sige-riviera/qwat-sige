      <labeling type="simple">
        <settings calloutType="simple">
          <text-style tabStopDistanceUnit="Point" fontSizeUnit="Point" legendString="Aa" previewBkgrdColor="255,255,255,255,rgb:1,1,1,1" fontFamily="Arial" forcedBold="0" tabStopDistanceMapUnitScale="3x:0,0,0,0,0,0" namedStyle="Normal" multilineHeightUnit="Percentage" textOpacity="1" fontUnderline="0" fieldName="CASE&#xd;&#xa;WHEN  &quot;installation_type&quot; = 'chamber' THEN 'C. '&#xd;&#xa;WHEN &quot;installation_type&quot; = 'pressurecontrol' AND fk_pressurecontrol_type = 2801 THEN 'CR. '&#xd;&#xa;WHEN  &quot;installation_type&quot; = 'pressurecontrol' AND fk_pressurecontrol_type = 2802 THEN 'CCP. ' &#xd;&#xa;WHEN  &quot;installation_type&quot; = 'pressurecontrol' AND fk_pressurecontrol_type = 2803 THEN 'CRA. '&#xd;&#xa;WHEN  &quot;installation_type&quot; = 'pump' THEN 'P. ' &#xd;&#xa;WHEN  &quot;installation_type&quot; = 'source' THEN 'S. ' &#xd;&#xa;WHEN  &quot;installation_type&quot; = 'tank' THEN 'R. '&#xd;&#xa;WHEN  &quot;installation_type&quot; = 'treatment' THEN 'T. ' || &#xd;&#xa;  if(&quot;sanitization_uv&quot; IS TRUE,'UV ','') ||&#xd;&#xa;  if(&quot;sanitization_chlorine_liquid&quot; IS TRUE,'CL ','') ||&#xd;&#xa;  if(&quot;sanitization_chlorine_gazeous&quot; IS TRUE,'CG ','') ||&#xd;&#xa;  if(&quot;sanitization_ozone&quot; IS TRUE,'O3 ','') ||&#xd;&#xa;  if(&quot;filtration_membrane&quot; IS TRUE,'UF ','') ||&#xd;&#xa;  if(&quot;filtration_sandorgravel&quot; IS TRUE,'FS ','') ||&#xd;&#xa;  if(&quot;flocculation&quot; IS TRUE,'FL ','') ||&#xd;&#xa;  if(&quot;activatedcharcoal&quot; IS TRUE,'CA ','') ||&#xd;&#xa;  if(&quot;settling&quot; IS TRUE,'D','')&#xd;&#xa;ELSE '' &#xd;&#xa;END&#xd;&#xa;|| if(&quot;installation_type&quot; = 'treatment' OR  &quot;fk_parent&quot; IS NOT NULL,'',name)&#xd;&#xa;||&#xd;&#xa;CASE WHEN  &quot;installation_type&quot;  = 'tank' THEN &#xd;&#xa;&#x9;COALESCE('\n'|| round(&quot;altitude_apron&quot;) ||'m','')&#xd;&#xa;&#x9;||'\n'&#x9;||&#xd;&#xa;&#x9;COALESCE(  &quot;storage_supply&quot;,'-')||'m3 / '||COALESCE(  &quot;stora