                <rules key="{8ac6d04b-1bb5-46e9-b2fb-236cb107ffc9}">
                  <rule key="{7a025dab-c7fe-4c7c-9f0b-25a39f73abd8}" scalemindenom="1" description="toutes les vannes sauf organe réseau et vanne d'hydrant" label="réseau" scalemaxdenom="100000" filter=" COALESCE(&quot;schema_force_visible&quot;,&quot;valve_function_schema_visible&quot;) IS TRUE &#xa;AND COALESCE( &quot;pipe_schema_force_visible&quot; , &quot;pipe_pipe_function_schema_visible&quot; ) IS TRUE">
                    <rule key="{edf1c363-d849-4700-82d0-34d494178d4d}" symbol="0" label="Fermée" filter="closed IS TRUE"/>
                    <rule key="{6c48a279-b0d9-428b-819c-2fc5371720fe}" symbol="1" label="arrêt" filter="&quot;fk_valve_type&quot; =6313"/>
                    <rule key="{8f1997aa-ce0e-467b-a33f-719c22255041}" symbol="2" label="vidange" filter="fk_valve_function IN (6110,6112)"/>
