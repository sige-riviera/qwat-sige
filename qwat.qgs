      <widgets>
        <widget name="relation_cover_installation">
          <config type="Map">
            <Option type="bool" value="false" name="force-suppress-popup"/>
            <Option type="invalid" name="nm-rel"/>
          </config>
        </widget>
        <widget name="relation_installation_parent">
