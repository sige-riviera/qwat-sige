        <field typeName="text" precision="-1" length="-1" type="10" subType="0" comment="" name="full_path" expression="CASE &#xd;&#xa;WHEN @qgis_os_name = 'linux' THEN 'smb://s3aviron.sige.ch/exploitation/01_EAU_POTABLE/00_DOC_TECHNIQUE/COMMUNES/'&#xd;&#xa;ELSE 'N:\\01_EAU_POTABLE\\00_DOC_TECHNIQUE\\01_RESEAU\\COMMUNES\\'&#xd;&#xa;END&#xd;&#xa;|| &#xd;&#xa;CASE&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '82' THEN 'Blonay'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '84' THEN 'Chardonne'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '81' THEN 'Corseaux'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '80' THEN 'Corsier'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '88' THEN 'Jongny'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '95' THEN 'Lausanne'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '51' THEN 'Montreux'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '43' THEN 'Port-Valais'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '83' THEN 'St_Legier'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '60' THEN 'La_Tour_de_Peilz'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '71' THEN 'Vevey'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '50' THEN 'Veytaux'&#xd;&#xa;WHEN regexp_substr(&quot;file&quot;, '(^\\d+)') = '37' THEN 'Villeneuve-Noville'&#xd;&#xa;ELSE regexp_substr(&quot;file&quot;, '(^[A-Za-z]+)')&#xd;&#xa;END&#xd;&#xa;|| &#xd;&#xa;CASE &#xd;&#xa;WHEN @qgis_os_name = 'linux' THEN '/Croquis_reseau/'&#xd;&#xa;ELSE '\\Croquis_reseau\\'&#xd;&#xa;END&#xd;&#xa;|| &quot;file&quot;"/>
