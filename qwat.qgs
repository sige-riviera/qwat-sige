                  <rule key="{51f9710c-2f47-4494-8534-c728849caf89}" symbol="3" filter="&quot;type&quot; = 4  AND if (@sige_plan_name IS NULL or @sige_plan_name = '', TRUE, array_contains(string_to_array(@sige_plan_name,';'),&quot;plan_name&quot;)) AND &quot;visibility_qgis&quot; IN (TRUE,NULL)" label="4 = By-pass"/>
