          <rule filter="&quot;fk_pipe&quot; IS NOT NULL AND &quot;pipe_status_functional&quot; IS TRUE" key="{e514b9fe-f3f7-4d71-b649-b0e192f0df27}" symbol="0" label="Fuite sur conduite fonctionnelle"/>
